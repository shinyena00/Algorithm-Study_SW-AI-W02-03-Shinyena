class Solution:
    def maxPoints(self, points: List[List[int]]) -> int:
        n = len(points)
        result = 0


        if n == 1:
            return 1

        for i in range(n-1):
            temp = {}
            for j in range(i+1, n):
                if points[i][0] - points[j][0] == 0:
                    if "vertical" not in temp:
                        temp["vertical"] = 1
                    else:
                        temp["vertical"] += 1
                elif points[i][1] - points[j][1] == 0:
                    if "horizon" not in temp:
                        temp["horizon"] = 1
                    else:
                        temp["horizon"] += 1
                
                else:
                    num = (points[i][0] - points[j][0]) / (points[i][1] - points[j][1])
                    if num not in temp:
                        temp[num] = 1
                    else:
                        temp[num] += 1
                
                margin = max(temp.values())
                if margin + 1 > result:
                    result = margin + 1

        return result
                
            